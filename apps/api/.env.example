APP_NAME=Starter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Canonical timestamps stay UTC in the database; this is the timezone the
# application reasons in. Keje is operated from Pontianak, Indonesia.
APP_TIMEZONE=Asia/Pontianak

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
# SQLite is the default for local dev. For production, switch DB_CONNECTION
# to mysql/pgsql and populate the matching credentials below.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
# Rendering MUST NOT run in a web request. Keep this off "sync" — a worker
# consumes the "media" queue:
#   php artisan queue:work --queue=media,default --timeout=7200 --tries=2
QUEUE_CONNECTION=database

# --- Mail (log driver is safe for local dev) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ---
# Token lifetime used by AuthController (hours). 0 = no expiration.
SANCTUM_TOKEN_EXPIRATION_HOURS=8

# --- Rate limiting ---
# Max requests per minute for public auth endpoints (login, register,
# forgot/reset password). Keyed by authenticated user or IP.
AUTH_THROTTLE_PER_MINUTE=10

# --- Email verification ---
# How long the signed verification link stays valid (minutes).
VERIFICATION_LINK_TTL_MINUTES=60
# Domains that receive stateful auth cookies. Only needed when the web app
# uses SPA-cookie auth instead of the default bearer-token auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# --- CORS ---
# Comma-separated list of origins that may call the API from a browser.
# The web app origin(s) must be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=0
# Only set to true when using SPA-cookie auth mode.
CORS_SUPPORTS_CREDENTIALS=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# ─── Media rendering (Laravel/VPS only — never Vercel) ──────────────────────
#
# FFmpeg does the rendering and must be installed on the API host. Verify the
# whole media environment with:  php artisan media:diagnose

MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe

# TrueType fonts used by the video templates. Both must exist on the host.
MEDIA_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
MEDIA_FONT_BOLD_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Upload ceilings. PHP's upload_max_filesize / post_max_size and Nginx's
# client_max_body_size must be at least this large.
MEDIA_MAX_AUDIO_MB=512
MEDIA_MAX_IMAGE_MB=20

# Output canvas and frame rate.
MEDIA_VIDEO_WIDTH=1280
MEDIA_VIDEO_HEIGHT=720
MEDIA_VIDEO_FPS=30

# H.264 quality/speed. Lower CRF is higher quality and a larger file.
MEDIA_VIDEO_CRF=20
MEDIA_VIDEO_PRESET=medium

# Waveform overlay.
MEDIA_WAVE_WIDTH=640
MEDIA_WAVE_HEIGHT=150
MEDIA_WAVE_COLOR=red
MEDIA_WAVE_MODE=cline

# Normalised output audio track.
MEDIA_AUDIO_SAMPLE_RATE=48000
MEDIA_AUDIO_BITRATE=256k

# EBU R128 loudness normalisation. OFF by default — lecture audio should not be
# materially altered without intent. A project can opt in per render.
MEDIA_LOUDNORM_ENABLED=false

# Hard ceiling for one render. Keep below the queue worker's --timeout.
MEDIA_RENDER_TIMEOUT=7200

# How long a signed video playback link stays valid (minutes).
MEDIA_STREAM_LINK_TTL_MINUTES=30

# How long a render may sit queued before the studio explains the wait rather
# than showing a progress bar stuck at 0. A missing queue worker is the usual
# cause, and nothing else ever reports it.
MEDIA_QUEUE_STALL_SECONDS=120

# The group PHP-FPM and the queue worker run as, and that the deploy user must
# join. Only `media:diagnose` reads it — Keje never changes permissions itself.
MEDIA_RUNTIME_GROUP=www-data

# ─── Google (two separate OAuth clients) ────────────────────────────────────
#
# Server-side OAuth only. These are secrets: they belong on the Laravel/VPS
# host, never in Vercel and never in a NEXT_PUBLIC_* variable.
#
# YouTube and Drive are authorized SEPARATELY, through two different OAuth
# clients. Google rejects any consent request that mixes the YouTube scopes
# with drive.file ("scopes that cannot be requested together"), so they can
# never share one client.
#
# Each redirect URI must exactly match the one registered on its own OAuth
# client, and points at the API:
#   https://api.yourapp.com/api/v1/integrations/youtube/callback
#   https://api.yourapp.com/api/v1/integrations/drive/callback

# Scopes: youtube.upload, youtube.readonly
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

# Scope: drive.file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/drive/callback

# ─── Local retention ────────────────────────────────────────────────────────
#
# The VPS is working space, not an archive. Once Drive confirms it holds the
# rendered MP4, the files that produced it are deleted to keep disk flat.
#
# This is a real trade: a pruned project can never be re-rendered, because its
# source audio is gone. Every text and metadata field stays in the database and
# the project points at its Drive copy. Nothing is ever deleted without a
# confirmed Drive backup.
#
# Set both to false to keep everything on disk.

MEDIA_PRUNE_SOURCES_AFTER_BACKUP=true
MEDIA_PRUNE_OUTPUT_AFTER_BACKUP=true

# The YouTube upload reads the same local MP4, so the render is held until
# YouTube also has a copy. Set false if Drive is your only destination.
MEDIA_RETAIN_OUTPUT_FOR_YOUTUBE=true

# Optional. When empty, Keje creates/reuses a folder named below.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME="Keje YouTube Outputs"

# Uploads are refused when the connected account controls a different channel.
YOUTUBE_EXPECTED_CHANNEL_ID=UCGxBzjbs5jNmcdlb9WaTtVQ
# 27 = Education
YOUTUBE_DEFAULT_CATEGORY_ID=27

# Which region's assignable category list to offer, and the language to name
# them in. Categories differ by region, so this decides which options appear
# in the studio's Category chooser.
YOUTUBE_DEFAULT_REGION_CODE=ID
YOUTUBE_METADATA_LANGUAGE=id
